{
  "name": "nexcart-full-stack",
  "version": "1.0.0",
  "description": "An ecommerce platform built using MERN stack.",
  "main": "index.js",
  "scripts": {
    "install": "cd backend && npm install && cd ../frontend && npm install",
    "dev:server": "cd backend && npm run dev",
    "dev:client": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd frontend && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-kaushik/NexCart.git"
  },
  "author": "Lokesh Kaushik",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/l-kaushik/NexCart/issues"
  },
  "homepage": "https://github.com/l-kaushik/NexCart#readme",
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
